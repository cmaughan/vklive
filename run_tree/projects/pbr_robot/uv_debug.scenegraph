// UV/material probe for the PBR glTF robot.
// Left half samples engine UVs with model texture-origin correction. Right half flips V for comparison.

camera: default_camera {
    position: (0.0, -2.25, 6.0)
    look_at: (0.0, -1.25, 0.0)
    field_of_view: 45.0
    near_far: (0.01, 50.0)
}

environment: studio_sky {
    path: textures/environment/farm_field_puresky_1k.hdr
    format: rgba32f
}

model: robot {
    path: models/robot/scene.gltf
    scale: (1.0, 1.0, 1.0)
    uv_origin: lower_left
}

pass: Sky {
    targets: (default_color, default_depth)
    clear: (0.0, 0.0, 0.0, 1.0)
    samplers: (studio_sky)
    camera: default_camera
    geometry: background {
        path: screen_rect
        vs: skybox.vert
        fs: skybox.frag
    }
}

pass: RobotUvDebug {
    targets: (default_color, default_depth)
    samplers: (studio_sky)
    camera: default_camera
    geometry: robot_mesh {
        model: robot
        vs: pbr.vert
        fs: uv_debug.frag
    }
}
